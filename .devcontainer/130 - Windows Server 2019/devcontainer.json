{
  "name": "Windows Server 2019",
  "service": "windows",
  "containerEnv": {
    "VERSION": "2019",
    "AUDIO": "Y",
    "LANGUAGE": "Thai",
    "REGION": "en-US",
    "KEYBOARD": "th-TH",
    "SAMBA": "Y",
    "SHORTCUT": "Y",
    "SHUTDOWN": "Y"
  },
  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "Web",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "dockerComposeFile": "../codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
